# Lineaje UnifAI Guardrail settings
#
# 1. Copy every KEY=VALUE line below into your application's .env file
#    (or set them as environment variables where your application runs).
# 2. Set LINEAJE_REFRESH_TOKEN to your Lineaje refresh token (it is left empty here).
# 3. Restart your application.
#
# LINEAJE_REFRESH_TOKEN is a credential: keep it secret and never commit
# your real .env file.

GR_SERVICE_URL=https://mcp.commercialdev.dev.veedna.com/enforce
GR_HEARTBEAT_URL=https://mcp.commercialdev.dev.veedna.com/heartbeat
LINEAJE_RENEW_ACCESS_TOKEN_URL=https://scim-service.commercialdev.dev.veedna.com/scim/api/v1/auth/native/renew-access-token
LINEAJE_REFRESH_TOKEN=
